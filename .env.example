# ==============================================================================
# BB-SUITE Environment Configuration Example
# Copy this file to .env or key.env and fill in your values.
# NEVER commit real API keys, secrets, or passwords to git.
# ==============================================================================

# Server & Deployment
BB_ENV=production
BB_HOST=127.0.0.1
BB_PORT=8000

# Authentication & Admin Credentials
BB_ADMIN_USERNAME=admin
BB_ADMIN_PASSWORD=change-this-secure-admin-password
BB_SECRET_KEY=change-this-to-a-random-secret-key-for-hmac-tokens
BB_TOKEN_EXPIRE_HOURS=24

# Target Security Boundary
# Set to true ONLY for authorized local lab / CTF testing on localhost/private IPs
BB_ALLOW_PRIVATE_TARGETS=false
BB_LOCAL_LAB_MODE=false

# TLS Verification
# Set to true ONLY if you must test servers with self-signed TLS certificates
BB_ALLOW_INSECURE_TLS=false

# Request Limits
BB_MAX_RESPONSE_SIZE=5242880
BB_MAX_REDIRECTS=5
BB_TIMEOUT_CONNECT=5.0
BB_TIMEOUT_READ=10.0
BB_TIMEOUT_TOTAL=15.0

# CORS Allowed Origins (comma-separated)
BB_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Local AI / LLM Configuration (Ollama / Local inference)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_MODEL=deepseek-r1

# External Security Tool Integrations
ZAP_API_KEY=your-owasp-zap-api-key-here
ZAP_HOST=http://localhost:8080
